# Copy to .env.local and adjust. All of these are read in the browser, so none may hold a secret.

# true  = use the built-in mock API (default; works with no backend)
# false = call the real backend at NEXT_PUBLIC_API_URL
NEXT_PUBLIC_USE_MOCKS=true

# Base URL of the real backend, for example https://api.example.com
NEXT_PUBLIC_API_URL=

# Public address of this site. Used for canonical links, the sitemap, robots.txt and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# true = the mock API randomly fails some requests so you can see the error states
NEXT_PUBLIC_MOCK_FAILURES=false
